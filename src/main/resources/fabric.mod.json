{
  "schemaVersion": 1,
  "id": "chomagerie",
  "version": "${version}",
  "name": "Chomagerie",
  "description": "Quality-of-life tools for Chomagerie: automatic shulker refills, player tags, recipes, crop protection, a Survival Debug Stick and persistent block state locks. Includes an optional client overlay with customizable colors to locate locked blocks through walls.",
  "authors": [
    "mal0andre"
  ],
  "contact": {
    "homepage": "https://golriver.fr",
    "sources": "https://github.com/mal0andre/ChomagerieMOD",
    "issues": "https://github.com/mal0andre/ChomagerieMOD/issues",
    "discord": "https://discord.gg/jYrjqckBTP",
    "license": "https://github.com/mal0andre/ChomagerieMOD/blob/master/LICENSE.txt"
  },
  "contributors": [
    "Chomagerie server contributors"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/chomagerie/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "tech.maloandre.chomagerie.client.ChomagerieDataGenerator"
    ],
    "client": [
      "tech.maloandre.chomagerie.client.ChomagerieClient"
    ],
    "main": [
      "tech.maloandre.chomagerie.Chomagerie"
    ],
    "modmenu": [
      "tech.maloandre.chomagerie.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "chomagerie.mixins.json",
    {
      "config": "chomagerie.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "malilib": "*",
    "minecraft": "${minecraft_version}"
  }
}
